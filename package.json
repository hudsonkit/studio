{
  "name": "studio",
  "version": "0.0.0",
  "private": true,
  "description": "Shared design-studio primitives + local host CLI (`studio dev` \u2192 {repo}.studio.local). Shell, page registry, doc/code viewers, atoms, router adapters. Internal; consumed via bun workspace.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "examples/*",
    "../hudson/packages/web/hudsonkit",
    "../lattices/design/studio",
    "../action/design/studio"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./registry": "./src/registry/index.ts",
    "./components": "./src/components/index.ts",
    "./components/verify": "./src/components/verify.ts",
    "./shell": "./src/shell/index.ts",
    "./doc": "./src/doc/index.ts",
    "./code": "./src/code/index.ts",
    "./local": "./src/local/index.ts",
    "./scout": "./src/scout/index.ts",
    "./agents": "./src/agents/index.ts",
    "./scout/server": "./src/scout/server.ts",
    "./injection": "./src/injection/index.tsx",
    "./atoms": "./src/atoms/index.ts",
    "./router": "./src/router/index.ts",
    "./router/next": "./src/router/next.tsx",
    "./theme": "./src/theme/index.ts",
    "./theme.css": "./src/theme/aliases.css",
    "./injection.css": "./src/injection/styles.css",
    "./app-shell": "./src/app-shell/index.ts",
    "./flows": "./src/flows/index.ts",
    "./flows/model": "./src/flows/model.ts",
    "./flows/render": "./src/flows/render.tsx",
    "./flows/server": "./src/flows/server/index.ts",
    "./flows/styles.css": "./src/flows/styles.css",
    "./doc.css": "./src/doc/eng-doc.css",
    "./shell.css": "./src/shell/shell.css"
  },
  "files": [
    "src",
    "bin"
  ],
  "bin": {
    "studio": "./bin/studio.mjs",
    "studio-local": "./src/local/cli.ts",
    "studio-flows": "./src/flows/server/cli.ts"
  },
  "scripts": {
    "dev": "bun run --cwd apps/studio dev",
    "dev:raw": "bun run --cwd apps/studio dev:raw",
    "local": "bun src/local/cli.ts",
    "local:serve": "bun src/local/cli.ts serve",
    "local:edge": "bun src/local/cli.ts edge",
    "flows:serve": "bun src/flows/server/cli.ts serve",
    "flows:smoke": "bun src/flows/server/smoke.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "next": ">=16",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "dependencies": {
    "hudsonkit": "workspace:*",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.0",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.43.0",
    "@lezer/highlight": "^1.2.0",
    "@uiw/react-codemirror": "^4.25.10",
    "lucide-react": "^0.574.0",
    "react-markdown": "^9.0.0",
    "rehype-highlight": "^7.0.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "next": "^16.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.5.0",
    "vite": "^7.1.0",
    "@vitejs/plugin-react": "^5.0.0"
}
}
