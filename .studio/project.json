        {
          "label": "Controller",
          "path": "/renders/act-controller"
        },
        {
          "label": "Keycaps",
          "path": "/renders/act-keycap"
        }
      ]
    }
  ],
  "scout": {
    "webBaseUrl": "http://127.0.0.1:43120",
