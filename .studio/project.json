{
  "version": 1,
  "id": "studio",
  "label": "Studio",
  "studioDir": "apps/studio",
  "start": "bun next dev --hostname 0.0.0.0 --port {port}",
  "healthPath": "/studio",
  "rootPath": "/studio",
  "host": "studio.studio.local",
  "preferredPort": 5191,
  "previews": [
    {
      "id": "action",
      "label": "Action",
      "host": "action.studio.local",
      "description": "Live capture overlays and operator HUD treatments.",
